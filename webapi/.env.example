# SQL Server credentials used by iis-setup-local.ps1 (local dev) and iis-setup.ps1 (production).
# iis-setup-local.ps1 injects DB_USER / DB_PASSWORD as IIS App Pool environment variables.
# ASP.NET Core (Program.cs) reads them at startup and builds the connection string at runtime.
# Copy this file to webapi/.env and fill in your values. Never commit .env to source control.

# SQL Server application login (used by ASP.NET Core at runtime via App Pool env vars)
DB_USER=webcompanion_user
DB_PASSWORD=YourSecure!Password1

# SQL Server 'sa' password (used only by iis-setup.ps1 -DbPassword when initialising the database)
SA_PASSWORD=YourStrong!Passw0rd
